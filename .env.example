# Copier en .env (jamais commite). Toutes les variables sont optionnelles.

# --- LLM (sections 5 et 6 de l'interface)
# Fournisseur : anthropic (API Claude) ou ollama (local, aucune donnee ne quitte la machine)
# P9_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# P9_LLM_MODEL=claude-opus-5-5
# P9_LLM_EFFORT=medium
# OLLAMA_HOST=http://localhost:11434
# P9_OLLAMA_MODEL=qwen2.5:7b

# --- Chemins
# P9_DATA_DIR=data/usershaker
# P9_OUT_DIR=out
# Parseur OMG : dossier de travail SANS espace, et JDK 21 deja installe (sinon telecharge)
# P9_SYSML_HOME=C:/sysml-cache
# P9_JAVA_HOME=C:/Program Files/Java/jdk-21
